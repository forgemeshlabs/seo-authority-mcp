{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.forgemeshlabs/seo-authority-mcp",
  "description": "SEO authority, keyword, competitor, content, site-audit, and internal-link tools with optional.",
  "repository": {
    "url": "https://github.com/forgemeshlabs/seo-authority-mcp",
    "source": "github"
  },
  "version": "0.1.3",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@forgemeshlabs/seo-authority-mcp",
      "version": "0.1.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SEO_X402_PRIVATE_KEY",
          "description": "Optional EVM wallet private key for automatic x402 USDC settlement.",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "https://forgemesh.io/favicon.png",
      "mimeType": "image/png",
      "sizes": [
        "1254x1254"
      ]
    }
  ]
}
